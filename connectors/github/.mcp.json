{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "${GITHUB_TOOLSETS:-}",
        "X-MCP-Readonly": "${GITHUB_READ_ONLY:-}"
      }
    }
  }
}
