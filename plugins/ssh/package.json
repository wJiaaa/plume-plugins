{
  "name": "@plume-plugins/ssh",
  "version": "0.1.1",
  "description": "管理 SSH 主机、在面板里开 SSH 终端和 SFTP 文件；Agent 可以在你连上的服务器上请求执行命令，每一条都由你核对后才运行。",
  "author": "Plume",
  "keywords": [
    "ssh",
    "sftp",
    "运维",
    "服务器",
    "终端",
    "面板",
    "页面"
  ],
  "plume": {
    "displayName": "SSH",
    "category": "工具",
    "defaultPrompt": [
      "看看这台服务器为什么磁盘满了",
      "帮我查一下 nginx 为什么起不来"
    ]
  },
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@plumeai/plugin-sdk": "catalog:",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/ssh2": "1.15.6",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "exceljs": "4.4.0",
    "react": "^19.3.1",
    "vitest": "^5.1.0"
  }
}
