{
  "name": "@plume-plugins/plan",
  "version": "0.1.0",
  "description": "计划模式：先只读调查、交一份计划，你批准之前不改任何文件；批准后同一轮接着动手。",
  "author": "Plume",
  "keywords": [
    "plan",
    "计划",
    "计划模式"
  ],
  "plume": {
    "displayName": "计划模式",
    "category": "工作流",
    "defaultPrompt": [
      "/plan 先看看这个项目的结构，给我一份重构计划"
    ]
  },
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "devDependencies": {
    "@plume/plugin-sdk": "link:../../../plume/packages/sdk/plugin-sdk",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0"
  }
}
