{
  "name": "@plume-plugins/terminal",
  "version": "0.1.1",
  "description": "在面板区开真正的终端：shell 起在会话的工作目录，一个标签一个 shell，切走再回来接着用。",
  "author": "Plume",
  "keywords": [
    "terminal",
    "shell",
    "终端",
    "面板"
  ],
  "plume": {
    "displayName": "终端",
    "category": "工具"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/pty-helper.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@plumeai/plugin-sdk": "catalog:",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "react": "^19.3.1",
    "vitest": "^5.1.0"
  }
}
