{
  "name": "@plume-plugins/sessions",
  "version": "0.1.0",
  "description": "让对话读别的对话、互相递话：同一个项目或目录里的对话互相看得到，读不打断它；问它、回它、告诉它一件事，信送进对方对话，答复作为一条消息送回来。",
  "author": "Plume",
  "keywords": [
    "会话",
    "协作",
    "read_session",
    "ask_session",
    "reply_session",
    "notify_session"
  ],
  "plume": {
    "displayName": "会话互通",
    "category": "工作流"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "devDependencies": {
    "@plume/plugin-sdk": "link:../../../plume/packages/sdk/plugin-sdk",
    "@types/node": "^24.10.0"
  }
}
